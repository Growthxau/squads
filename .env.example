# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DERIV_APP_ID: Registered Deriv App ID (defaults to 1089 if unset).
# Users can register their custom App ID at https://developers.deriv.com
DERIV_APP_ID="1089"

# SESSION_SECRET: Secret string used to sign user authentication cookies/tokens.
SESSION_SECRET="your-super-secret-session-key-minimum-32-chars"

# ENCRYPTION_KEY: 32-byte secret key (64 hex characters) for encrypting Deriv PATs at rest on the server.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional: Email Service Credentials (SMTP or Resend)
# If not configured, verification codes are safely made accessible in the verification UI for quick onboarding.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@g-squad.trade"

